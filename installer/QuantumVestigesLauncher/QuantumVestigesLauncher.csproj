<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <DeployEnv Condition="'$(DeployEnv)' == ''">devo</DeployEnv>
  </PropertyGroup>
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ApplicationIcon>assets/icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="assets/*.jpg" Exclude="assets\config.*.json" />
    <EmbeddedResource Include="assets\config.$(DeployEnv).json" Link="assets\config.json" />
  </ItemGroup>
</Project>
