<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gamerparadise.dao.mapper.AccountDAOMapper">
    <resultMap id="CartResultMap" type="CartDAODTO">
        <result property="username" column="username"/>
        <result property="gameId" column="game_id"/>
        <result property="gameName" column="game_name"/>
        <result property="franchiseId" column="franchise_id"/>
        <result property="franchiseName" column="franchise_name"/>
    </resultMap>

    <select id="getCart" parameterType="String" resultMap="CartResultMap">
        SELECT
			*
		FROM cart WHERE username = #{username};
    </select>

    <insert id="insertItem" parameterType="CartDAODTO">
        INSERT INTO cart(username, game_id, game_name, franchise_id, franchise_name)
		VALUES(#{username}, #{gameId}, #{gameName}, #{franchiseId}, #{franchiseName});
    </insert>

    <delete id="removeItem" parameterType="CartDAODTO">
        DELETE FROM cart WHERE username = #{username} AND game_id = #{gameId} AND franchise_id = #{franchiseId};
    </delete>

    <delete id="clearCart" parameterType="String">
        DELETE FROM cart WHERE username = #{username};
    </delete>

	<insert id="addItemsToAccount" >
        INSERT INTO purchased_items (username, id, name, type)
        VALUES
        <foreach collection="items" item="item" separator=",">
            (#{username}, #{item.id}, #{item.name}, #{item.type})
        </foreach>
		;
    </insert>
</mapper>