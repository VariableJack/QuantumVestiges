<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gamerparadise.dao.mapper.ProductsDAOMapper">
    <resultMap id="ProductResultMap" type="ProductDAODTO">
        <id property="productId" column="product_id"/>
        <result property="productName" column="product_name"/>
        <result property="parentProductId" column="parent_product_id"/>
        <result property="productType" column="product_type"/>
        <result property="franchiseId" column="franchise_id"/>
        <result property="franchiseName" column="franchise_name"/>
        <result property="description" column="description"/>
        <result property="thumbnail" column="thumbnail"/>
        <result property="assets" column="assets"/>
        <result property="releaseDate" column="release_date"/>
        <result property="owner" column="owner"/>
        <result property="releaseState" column="release_state"/>
        <result property="price" column="price"/>
    </resultMap>

    <select id="getProducts" parameterType="ProductDAODTO" resultMap="ProductResultMap">
        SELECT * FROM products WHERE franchise_id = #{franchiseId};
    </select>

    <select id="getProductByFilters" parameterType="ProductDAODTO" resultMap="ProductResultMap">
        SELECT * FROM products
        <where>
        <if test="product.productId != null">
            AND product_id = #{product.productId}
        </if>
        <if test="product.productName != null">
            AND product_name = #{product.productName}
        </if>
        </where>
        ;
    </select>

    <insert id="insertProduct" parameterType="ProductDAODTO"
        useGeneratedKeys="true" keyColumn="product_id" keyProperty="productId">
        INSERT INTO products(
            product_name,
            parent_product_id,
            product_type,
            franchise_id,
            franchise_name,
            description,
            thumbnail,
            assets,
            <if test="product.releaseState != null">
                release_date,
                release_state,
            </if>
            owner,
            price
        )
        VALUES(
            #{product.productName},
            #{product.parentProductId},
            #{product.productType},
            #{product.franchiseId},
            #{product.franchiseName},
            #{product.description},
            #{product.thumbnail},
            #{product.assets},
            <if test="product.releaseState != null">
                CURRENT_DATE(),
                product.releaseState,
            </if>
            #{owner},
            #{product.price}
        );
    </insert>

    <select id="getProductsByOwner" parameterType="String" resultMap="ProductResultMap">
        SELECT * FROM products WHERE owner = #{username};
    </select>

    <update id="releaseProduct" parameterType="ProductDAODTO">
        UPDATE products SET release_date = CURRENT_DATE(), release_state = 'RELEASE' WHERE product_id = #{product.productId};
    </update>
</mapper>